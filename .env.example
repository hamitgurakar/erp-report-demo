# Muhiku ERP Raporlama — Supabase (muhiku-portal ile AYNI proje)
# Bu değerler publishable anon key'dir (client tarafında görünmesi güvenlidir).
VITE_SUPABASE_URL=https://<proje>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# --- ProjectSwitcher: kardeş proje linkleri (opsiyonel) ---
# Set edilmezse prod'da relative path (/influencer), dev'de canlı portal kullanılır.
# VITE_PORTAL_ORIGIN=http://localhost:5175
# Dev portları: erp-report 5173 (varsayılan), influencer-rating 5174 (sabit).
# Sondaki / zorunlu — Vite dev sunucusu base'siz path'te 404 döner.
# VITE_INFLUENCER_URL=http://localhost:5174/influencer/
